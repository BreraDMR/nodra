# Public shop contacts and seller details. Leave a value empty and its block stays hidden.
# NEXT_PUBLIC_ values are baked in at build time, rebuild after changing them.

# WhatsApp number in international format, digits only, e.g. 420 followed by the number
NEXT_PUBLIC_SHOP_WHATSAPP=
# Telegram username without the @
NEXT_PUBLIC_SHOP_TELEGRAM=
# Support email shown in the footer
NEXT_PUBLIC_SHOP_EMAIL=
# Seller's legal name, as registered
NEXT_PUBLIC_SELLER_NAME=
# Seller's IČO, 8 digits
NEXT_PUBLIC_SELLER_ICO=
# Seller's registered address on one line
NEXT_PUBLIC_SELLER_ADDRESS=

# Portfolio demo mode (P02). Set to 1 to run the shop as an explicit demo:
# a banner on every page plus notices in checkout and the receipt tell the
# visitor that orders are test orders and no payment or delivery happens.
# Leave empty for a real shop build.
NEXT_PUBLIC_DEMO_MODE=
